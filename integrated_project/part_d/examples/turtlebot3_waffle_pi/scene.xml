<mujoco model="tb3_waffle_pi_scene">
  <compiler angle="radian" inertiafromgeom="auto"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <asset>
    <texture name="grid_tex" type="2d" builtin="checker" width="256" height="256"
             rgb1="0.90 0.92 0.95" rgb2="0.78 0.81 0.85" mark="cross" markrgb="0.35 0.4 0.5"/>
    <material name="floor_mat" texture="grid_tex" texrepeat="8 8" reflectance="0.15"/>
    <material name="wall_mat" rgba="0.80 0.82 0.86 1"/>
    <material name="obstacle_mat" rgba="0.50 0.72 0.55 1"/>
    <material name="robot_body" rgba="0.12 0.12 0.15 1"/>
    <material name="robot_trim" rgba="0.82 0.82 0.82 1"/>
    <material name="marker_red" rgba="1 0.23 0.23 1"/>
    <material name="marker_blue" rgba="0.16 0.56 1 1"/>
    <material name="marker_green" rgba="0.30 0.80 0.45 1"/>
    <material name="marker_gold" rgba="0.98 0.78 0.15 1"/>
  </asset>

  <default>
    <geom contype="1" conaffinity="1" condim="3"/>
    <joint damping="0.05" frictionloss="0.01" armature="0.001"/>
    <motor ctrlrange="-3 3" forcerange="-10 10"/>
    <site rgba="0.7 0.8 1 0.25"/>
  </default>

  <worldbody>
    <light pos="2.5 2.0 5.0" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>

    <body name="room" pos="0 0 0">
      <geom name="floor" type="plane" size="3.0 2.5 0.01" pos="2.5 2.0 0" material="floor_mat"/>
      <geom name="south_wall" type="box" size="2.5 0.08 0.25" pos="2.5 -0.08 0.25" material="wall_mat"/>
      <geom name="north_wall" type="box" size="2.5 0.08 0.25" pos="2.5 4.08 0.25" material="wall_mat"/>
      <geom name="west_wall" type="box" size="0.08 2.0 0.25" pos="-0.08 2.0 0.25" material="wall_mat"/>
      <geom name="east_wall" type="box" size="0.08 2.0 0.25" pos="5.08 2.0 0.25" material="wall_mat"/>

      <geom name="obstacle_1" type="box" size="0.25 1.10 0.25" pos="1.75 1.10 0.25" material="obstacle_mat"/>
      <geom name="obstacle_2" type="box" size="0.25 1.10 0.25" pos="3.25 2.90 0.25" material="obstacle_mat"/>

      <body name="marker_dock" pos="5.00 0.90 0.46">
        <geom name="marker_dock_geom" type="box" size="0.012 0.18 0.18" pos="-0.012 0 0" material="marker_red" contype="0" conaffinity="0"/>
      </body>
      <body name="marker_1" pos="0.00 2.00 0.46">
        <geom name="marker_1_geom" type="box" size="0.012 0.18 0.18" pos="0.012 0 0" material="marker_blue" contype="0" conaffinity="0"/>
      </body>
      <body name="marker_2" pos="1.00 4.00 0.46">
        <geom name="marker_2_geom" type="box" size="0.18 0.012 0.18" pos="0 -0.012 0" material="marker_green" contype="0" conaffinity="0"/>
      </body>
      <body name="marker_3" pos="2.50 4.00 0.46">
        <geom name="marker_3_geom" type="box" size="0.18 0.012 0.18" pos="0 -0.012 0" material="marker_gold" contype="0" conaffinity="0"/>
      </body>
      <body name="marker_4" pos="5.00 3.00 0.46">
        <geom name="marker_4_geom" type="box" size="0.012 0.18 0.18" pos="-0.012 0 0" material="marker_blue" contype="0" conaffinity="0"/>
      </body>
      <body name="marker_5" pos="2.50 0.00 0.46">
        <geom name="marker_5_geom" type="box" size="0.18 0.012 0.18" pos="0 0.012 0" material="marker_red" contype="0" conaffinity="0"/>
      </body>
      <body name="marker_6" pos="0.60 0.00 0.46">
        <geom name="marker_6_geom" type="box" size="0.18 0.012 0.18" pos="0 0.012 0" material="marker_green" contype="0" conaffinity="0"/>
      </body>
    </body>

    <body name="base_footprint" pos="0.6 0.5 0.0" euler="0 0 1.57079632679">
      <freejoint name="base_free"/>
      <!-- centre of mass slightly behind the wheel axle so the robot rests on the rear casters -->
      <inertial pos="-0.03 0 0.07" mass="1.0" diaginertia="0.02 0.02 0.04"/>

      <geom name="base_link" type="box" size="0.12 0.12 0.04" pos="0 0 0.07" material="robot_body"/>
      <geom name="top_plate" type="box" size="0.11 0.11 0.02" pos="0 0 0.15" material="robot_trim"/>
      <geom name="front_bumper" type="box" size="0.16 0.04 0.02" pos="0.12 0 0.12" material="robot_trim"/>

      <body name="left_wheel_link" pos="0 0.143 0.033">
        <joint name="wheel_left_joint" type="hinge" axis="0 1 0" damping="0.02"/>
        <geom name="left_wheel" type="cylinder" size="0.033 0.020 0.01" euler="1.57079632679 0 0" material="robot_body"/>
      </body>

      <body name="right_wheel_link" pos="0 -0.143 0.033">
        <joint name="wheel_right_joint" type="hinge" axis="0 1 0" damping="0.02"/>
        <geom name="right_wheel" type="cylinder" size="0.033 0.020 0.01" euler="1.57079632679 0 0" material="robot_body"/>
      </body>

      <!-- two rear ball casters (as on the Waffle Pi); condim=1 + priority makes them frictionless so they roll freely
           (without priority MuJoCo takes the floor's friction and the casters drag like skids) -->
      <body name="caster_mount" pos="-0.10 0.0 0.02">
        <geom name="caster_left" type="sphere" size="0.02" pos="0 0.07 0" condim="1" priority="1" material="robot_trim"/>
        <geom name="caster_right" type="sphere" size="0.02" pos="0 -0.07 0" condim="1" priority="1" material="robot_trim"/>
      </body>

      <!-- MuJoCo cameras look along their -z axis; xyaxes puts image-right = -y_body and image-up = +z_body, so it looks along +x_body -->
      <camera name="front_camera" pos="0.14 0 0.18" xyaxes="0 -1 0 0 0 1" fovy="62.2"/>

      <!-- rangefinders measure along the site's +z axis; zaxis points it forward -->
      <site name="lidar_site" pos="0 0 0.18" zaxis="1 0 0" size="0.01"/>
    </body>
  </worldbody>

  <actuator>
    <!-- +-7.88 rad/s = v_max / r = 0.26 / 0.033, the Waffle Pi wheel-rate limit used by the controller -->
    <velocity name="wheel_left_vel" joint="wheel_left_joint" kv="1.0" ctrlrange="-7.88 7.88"/>
    <velocity name="wheel_right_vel" joint="wheel_right_joint" kv="1.0" ctrlrange="-7.88 7.88"/>
  </actuator>

  <sensor>
    <rangefinder name="lidar" site="lidar_site" cutoff="5.0"/>
  </sensor>
</mujoco>
